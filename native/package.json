{
  "name": "delta-core",
  "version": "0.1.0",
  "description": "Rust N-API core for Delta: vault filesystem, SQLite, watching, search, ICS.",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "delta-core",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --cwd . --output-dir . --js index.js --dts index.d.ts",
    "build:debug": "napi build --platform --cwd . --output-dir . --js index.js --dts index.d.ts",
    "test": "cargo test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9"
  },
  "engines": {
    "node": ">= 18"
  }
}
